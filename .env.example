# ============================================
# Study Buddy AI - Environment Variables
# ============================================

# Google Gemini API
# Get your free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# Database (SQLite default)
DATABASE_URL=sqlite:///./data/study_buddy.db

# Redis Cache (Optional: automatically falls back to in-memory cache if not running)
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB Vector Store
CHROMA_PATH=./data/chroma

# Application Settings
DEBUG=True
LOG_LEVEL=INFO

